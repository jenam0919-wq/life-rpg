# Render (or local backend) environment variables.
# Copy this file to .env for local backend-only development.

PORT=5000
FRONTEND_URL=http://localhost:5181
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
DATABASE_PATH=./database/life-rpg.db

# SQLite is stored in backend/database/life-rpg.db by default.
# Render's local filesystem is ephemeral; use a persistent disk or an
# external database for production data persistence.
